{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["dist/", "node_modules/", "*.js", "*.cjs"],
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-control-regex": "off"
  }
}

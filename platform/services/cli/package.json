{
  "name": "@minecraft-docker/mcctl",
  "version": "3.0.2",
  "description": "mcctl - Docker Minecraft server manager CLI and web console",
  "type": "module",
  "bin": {
    "mcctl": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docker",
    "templates",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest run && node --test tools/check-templates.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "sync-docker": "rm -rf docker && cp -r ../../docker docker",
    "prepack": "npm run sync-docker",
    "verify:package": "node tools/verify-package.mjs",
    "check:templates": "node tools/check-templates.mjs"
  },
  "keywords": [
    "mcctl",
    "minecraft",
    "minecraft-server",
    "docker",
    "cli",
    "mc-router",
    "server-management"
  ],
  "author": "smallmiro",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallmiro/minecraft-server-manager.git",
    "directory": "platform/services/cli"
  },
  "homepage": "https://mcctl.mirolab.dev/",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "dependencies": {
    "@clack/prompts": "^0.8.0",
    "@minecraft-docker/mod-source-modrinth": "workspace:*",
    "@minecraft-docker/shared": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.0",
    "pm2": "^6.0.14",
    "rcon-client": "^4.2.5",
    "tar": "^7.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "@types/tar": "^6.1.13",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}

# =============================================================================
# Server Configuration Template
# =============================================================================
# IMPORTANT: Create servers with mcctl (CLI or Web Console):
#   mcctl create <your-server-name> -t PAPER
# servers/<server-name>/server.yaml is the definition; mcctl writes this file from it.
#
# The server name you provide will be used for:
#   - Directory name: servers/<server-name>/
#   - Service name: mc-<server-name>
#   - Container name: mc-<server-name>
#   - Hostname: <server-name>.local
#
# After creation, edit this file to customize your server settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Type
# -----------------------------------------------------------------------------
TYPE=PAPER
# Options: VANILLA, PAPER, SPIGOT, FORGE, FABRIC, NEOFORGE, QUILT, MODRINTH, AUTO_CURSEFORGE
# See: https://docker-minecraft-server.readthedocs.io/en/latest/types-and-platforms/

# Minecraft Version
VERSION=1.20.4

# -----------------------------------------------------------------------------
# Resources
# -----------------------------------------------------------------------------
MEMORY=4G
# Recommended:
#   VANILLA/PAPER: 2G
#   FORGE/FABRIC: 4G
#   Modpacks: 6G+

# -----------------------------------------------------------------------------
# Game Settings
# -----------------------------------------------------------------------------
MODE=survival
# Options: survival, creative, adventure, spectator

DIFFICULTY=normal
# Options: peaceful, easy, normal, hard

MAX_PLAYERS=20
VIEW_DISTANCE=10
PVP=true
SPAWN_PROTECTION=0

# -----------------------------------------------------------------------------
# World
# -----------------------------------------------------------------------------
# World directory: /worlds/ (shared across servers)
# LEVEL specifies the world folder name within /worlds/
LEVEL=world

# Store world in shared /worlds/ directory (not in server's /data/)
EXTRA_ARGS=--universe /worlds/

# Option 2: Specific seed (set via mcctl create --seed)
# SEED=12345

# Option 3: Download from URL (set via mcctl create --world-url)
# WORLD=https://example.com/world.zip


# -----------------------------------------------------------------------------
# RCON (Password inherited from .env)
# -----------------------------------------------------------------------------
ENABLE_RCON=true

# -----------------------------------------------------------------------------
# Server MOTD (Message of the Day)
# -----------------------------------------------------------------------------
MOTD=Welcome! Your adventure begins here.

# -----------------------------------------------------------------------------
# Optional: Mods/Plugins
# -----------------------------------------------------------------------------
# MODRINTH_PROJECTS: |
#   fabric-api
#   lithium

# SPIGET_RESOURCES: "1234,5678"

# ⚠️ IMPORTANT: Auto-download mod dependencies from Modrinth
# Options: required, optional, none
# - required: Download required dependencies automatically (RECOMMENDED)
# - optional: Download required + optional dependencies
# - none: Don't download dependencies (manual management)
MODRINTH_DOWNLOAD_DEPENDENCIES=required

# -----------------------------------------------------------------------------
# Whitelist (disabled by default)
# -----------------------------------------------------------------------------
# Set by mcctl create when --whitelist / --enable-whitelist is given.
# ENABLE_WHITELIST=TRUE
# WHITELIST=player1,player2
# OPS=admin1,admin2

# -----------------------------------------------------------------------------
# Optional: Advanced
# -----------------------------------------------------------------------------
# USE_AIKAR_FLAGS=true
# ICON=https://example.com/icon.png
